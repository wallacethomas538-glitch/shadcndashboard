{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "registryVersion": "1.0.0",
  "registryId": "vektorflow-content-map",
  "updated": "2026-09-28",
  "purpose": "Canonical content and internal-link relationship registry for VektorFlow 15XR. Dashboard navigation, SEO generation, breadcrumbs, content generation, and future sitemap/link validation should consume this registry instead of maintaining independent relationship lists.",
  "authority": {
    "repository": "wallacethomas538-glitch/shadcndashboard",
    "branch": "main",
    "scope": "content architecture",
    "implementationStatus": "architecture registry; does not assert that every target page or agent is currently implemented"
  },
  "rules": {
    "canonicalId": "Every content node has a stable ID. IDs must not change when copy changes.",
    "canonicalPath": "Each indexable node should have one canonical route.",
    "incomingLinks": "Every indexable node should be reachable from at least one pillar or hub.",
    "outgoingLinks": "Links should be selected from explicit relationships plus contextual relationships generated from concepts.",
    "anchors": "Prefer descriptive anchors derived from target title or anchorAliases; never use generic 'click here'.",
    "platformNeutrality": "Shopify is an integration/use case, not the platform root.",
    "implementationTruth": "Target agents and future pages are content architecture nodes; do not imply runtime implementation until verified.",
    "templateContent": "Generic starter-template blog content is excluded from the VektorFlow SEO graph until replaced or intentionally migrated.",
    "linkDirection": "Edges are directional. Reciprocal links should be declared explicitly when useful."
  },
